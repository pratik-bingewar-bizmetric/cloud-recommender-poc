# ==============================================================================
# Cloud Recommender POC - .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment and Secrets
.env
.env*.local
.env.production
.env.staging
*.pem
*.key
*.cert
*.crt
secrets.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# Static Analysis, Linters, Type Checkers
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Node / Frontend (React / Vite / Next.js)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
.turbo/
.parcel-cache/

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Temporary & Scratch Files
scratch/
tmp/
temp/
*.tmp
*.log
logs/

# User Uploaded Artifacts & Ephemeral Ingestion Files
uploads/
*.zip
*.tar
*.tar.gz
*.pdf
*.docx
*.doc

# Database & Storage
*.sqlite3
*.db
data/cache/
data/exports/
*.sql
*.dump

# Microsoft Fabric & Local Analytics Data
.fabric/
fabric_artifacts/
*.parquet
*.delta/

# Terraform / Infrastructure (Generated Outputs)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc


