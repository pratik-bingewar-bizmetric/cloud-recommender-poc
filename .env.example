# ==============================================================================
# Cloud Recommender POC - Environment Variables Template
# Copy this file to .env and configure values before starting the application.
# NEVER commit .env to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_NAME=cloud-recommender-poc
APP_ENV=development                # options: development, testing, staging, production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# ------------------------------------------------------------------------------
# Relational Database (PostgreSQL)
# Stores workload profiles, chat/clarification histories, recommendations, and audit logs.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloud_recommender
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ------------------------------------------------------------------------------
# Agent Orchestration & LLM Configuration (LangGraph)
# Supported providers: 'mock', 'azure_openai', 'openai', 'gemini', 'anthropic'
# For local offline testing without cloud keys, set LLM_PROVIDER=mock
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock

# Azure OpenAI (Recommended for enterprise / Azure-aligned deployment)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Direct OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Global LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# Azure Read-Only Integration (Phase B - Cloud Telemetry & Cost Ingestion)
# CRITICAL: Credentials must have strictly read-only roles (Reader, Cost Management Reader)
# NEVER configure Contributor, Owner, or write-privileged credentials!
# ------------------------------------------------------------------------------
AZURE_AUTH_METHOD=service_principal   # options: service_principal, default_azure_credential
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id_here

# ------------------------------------------------------------------------------
# Microsoft Fabric Integration (Phase B - Lakehouse Analytics Layer)
# Used for storing resource telemetry, normalized billing data, and waste models.
# ------------------------------------------------------------------------------
FABRIC_ENABLED=false                  # Set to true when Microsoft Fabric capacity is provisioned
FABRIC_TENANT_ID=your_azure_tenant_id_here
FABRIC_CLIENT_ID=your_fabric_sp_client_id_here
FABRIC_CLIENT_SECRET=your_fabric_sp_client_secret_here
FABRIC_WORKSPACE_ID=your_fabric_workspace_id_here
FABRIC_LAKEHOUSE_ID=your_fabric_lakehouse_id_here
FABRIC_ONELAKE_ENDPOINT=https://onelake.dfs.fabric.microsoft.com

# ------------------------------------------------------------------------------
# Multi-Cloud Deterministic Pricing Engine
# Official Pricing API endpoints & offline fallback settings
# ------------------------------------------------------------------------------
AZURE_RETAIL_PRICES_API_URL=https://prices.azure.com/api/retail/prices
AWS_PRICE_LIST_API_ENDPOINT=https://pricing.us-east-1.amazonaws.com
GCP_BILLING_CATALOG_API_ENDPOINT=https://cloudbilling.googleapis.com/v1
PRICING_CACHE_TTL_HOURS=24
PRICING_CACHE_DIR=./backend/app/catalog/cache
OFFLINE_PRICING_MODE=true             # Set true to use bundled static dataset without live API calls

# ------------------------------------------------------------------------------
# File Upload & Ingestion Constraints (Security & Resource Limits)
# ------------------------------------------------------------------------------
MAX_DOCUMENT_SIZE_MB=25               # Max size for PDF / Word requirements documents
MAX_CODE_ARCHIVE_SIZE_MB=100          # Max size for application source ZIP
ALLOWED_DOCUMENT_EXTENSIONS=["pdf","docx","doc","txt","md"]
ALLOWED_ARCHIVE_EXTENSIONS=["zip"]
EPHEMERAL_STORAGE_PATH=./uploads/ephemeral

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                        # options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                       # options: json, console
ENABLE_AUDIT_LOGGING=true             # Audit log all analysis runs and recommendation generation
