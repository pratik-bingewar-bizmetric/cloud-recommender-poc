# ==============================================================================
# Cloud Recommender POC - Environment Variables Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_NAME=cloud-recommender-poc
APP_ENV=development                # options: development, testing, production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: 'gemini', 'openai', 'anthropic', 'mock'
# For local testing without external API keys, set LLM_PROVIDER=mock
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Claude API Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Global LLM Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Cloud Catalog & Rule Engine Configuration
# ------------------------------------------------------------------------------
CATALOG_DATA_PATH=./backend/app/catalog/data
OFFLINE_CATALOG_MODE=true          # Set true to use bundled catalog dataset without live pricing calls
ENABLE_EXPERIMENTAL_SERVICES=false

# ------------------------------------------------------------------------------
# Cost Estimation & FinOps Defaults
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_AWS_REGION=us-east-1
DEFAULT_AZURE_REGION=eastus
DEFAULT_GCP_REGION=us-central1
COST_BUFFER_PERCENTAGE=15          # Percentage safety buffer added to baseline estimation

# ------------------------------------------------------------------------------
# Logging & Telemetry
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                     # options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                    # options: json, console
